{
  "name": "shurfah-website",
  "private": true,
  "description": "موقع شُرفة التعريفي التجاري مع نظام إدارة المحتوى",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node --env-file=.env server/index.js",
